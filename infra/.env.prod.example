# AI Enterprise Lab
# Production environment template
#
# Copy this file OUTSIDE the repository, for example:
#
#   /etc/ai-enterprise-lab/production.env
#
# Recommended permissions for the real file:
#
#   mode 0600
#
# Never commit the real production env file.
# Secret values below intentionally remain empty.


# --------------------------------------------------
# Deployment / public hostname
# --------------------------------------------------

# Public DNS hostname only.
# Example: ai.example.com
APP_DOMAIN=

# Host header used by the internal Docker healthcheck.
# Normally the same hostname as APP_DOMAIN.
APP_HEALTHCHECK_HOST=

# JSON/Pydantic list.
# Example: ["ai.example.com"]
ALLOWED_HOSTS=

# Required immutable release tag. Never reuse a deployed tag.
# Example: git-a1b2c3d4
APP_IMAGE_TAG=


# --------------------------------------------------
# Local AI provider
# --------------------------------------------------

AI_DEFAULT_ORGANIZATION_SLUG=lab-default
AI_DEFAULT_PROVIDER=local_fast

AI_MAX_PROMPT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=2048

# Required.
# Set to the reachable Ollama endpoint for this deployment.
OLLAMA_BASE_URL=

AI_LOCAL_FAST_MODEL=qwen2.5-coder:3b
AI_LOCAL_DEEP_MODEL=qwen2.5-coder:7b-instruct-q3_K_S

AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_EMBEDDING_DIMENSIONS=1024


# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------

POSTGRES_DB=ai_enterprise_lab
POSTGRES_USER=ai_lab

# SECRET — required.
POSTGRES_PASSWORD=


# --------------------------------------------------
# Redis / rate limiting
# --------------------------------------------------

REDIS_DB=0

# SECRET — required.
REDIS_PASSWORD=

REDIS_CONNECT_TIMEOUT_SECONDS=1.0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_READINESS_TIMEOUT_SECONDS=3.0

RATE_LIMIT_PUBLIC_GENERATE_PER_MINUTE=12
RATE_LIMIT_PUBLIC_GENERATE_BURST=3

RATE_LIMIT_PUBLIC_RAG_PER_MINUTE=12
RATE_LIMIT_PUBLIC_RAG_BURST=3

RATE_LIMIT_AUTH_PREAUTH_PER_MINUTE=30
RATE_LIMIT_AUTH_PREAUTH_BURST=10

RATE_LIMIT_AUTH_PRINCIPAL_PER_MINUTE=30
RATE_LIMIT_AUTH_PRINCIPAL_BURST=5


# --------------------------------------------------
# External AI
# --------------------------------------------------

EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_PROVIDER=deepseek
EXTERNAL_AI_MODEL=deepseek-flash

# SECRET — required only when EXTERNAL_AI_ENABLED=true.
DEEPSEEK_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com

DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high

DEEPSEEK_PRICE_CACHE_HIT_OFFPEAK_PER_M=0.003
DEEPSEEK_PRICE_CACHE_MISS_OFFPEAK_PER_M=0.15
DEEPSEEK_PRICE_OUTPUT_OFFPEAK_PER_M=0.60
DEEPSEEK_PEAK_MULTIPLIER=2.0


# --------------------------------------------------
# n8n
# --------------------------------------------------

N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app

# SECRET — required.
N8N_DB_PASSWORD=

# SECRET — required.
# Generate a high-entropy stable value and preserve it across redeployments.
N8N_ENCRYPTION_KEY=

N8N_HOST=localhost
N8N_PROTOCOL=http

AGENT_TOOL_TIMEOUT_SECONDS=20.0
AGENT_GENERATION_TIMEOUT_SECONDS=30.0
