# Ambiente da aplicação
APP_ENV=development

# AI Providers
AI_DEFAULT_PROVIDER=local_fast

# Limites do AI Gateway
AI_MAX_PROMPT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=2048

# Ollama local
OLLAMA_BASE_URL=http://127.0.0.1:11434

AI_LOCAL_FAST_MODEL=qwen2.5-coder:3b
AI_LOCAL_DEEP_MODEL=qwen2.5-coder:7b-instruct-q3_K_S

# Embeddings
AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_EMBEDDING_DIMENSIONS=1024

# Organização padrão enquanto autenticação/ACL ainda não estão ativas
AI_DEFAULT_ORGANIZATION_SLUG=lab-default

# API externa
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_PROVIDER=deepseek
EXTERNAL_AI_MODEL=deepseek-v4-pro

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high

# DeepSeek pricing - USD por 1M tokens
DEEPSEEK_PRICE_CACHE_HIT_OFFPEAK_PER_M=0.022
DEEPSEEK_PRICE_CACHE_MISS_OFFPEAK_PER_M=0.66
DEEPSEEK_PRICE_OUTPUT_OFFPEAK_PER_M=1.98
DEEPSEEK_PEAK_MULTIPLIER=2.0

# Banco de dados
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_enterprise_lab
POSTGRES_USER=ai_lab
POSTGRES_PASSWORD=

# Segurança
APP_SECRET_KEY=

# n8n
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Privacidade
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false